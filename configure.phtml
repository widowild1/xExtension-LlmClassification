<script>
document.addEventListener('DOMContentLoaded', function() {
	const providerMeta = {
		<?php foreach ($allProviders as $p): ?>
		'<?= $p->getId() ?>': {
			requiresUrl: <?= $p->requiresCustomUrl() ? 'true' : 'false' ?>,
			placeholderUrl: '<?= addslashes($p->getPlaceholderUrl()) ?>',
			defaultModel: '<?= addslashes($p->getDefaultModel()) ?>',
			placeholderModel: '<?= addslashes($p->getPlaceholderModel()) ?>'
		},
		<?php endforeach; ?>
	};

	// Sélecteur principal
	const pSelect = document.getElementById('provider');
	const pUrlGroup = document.getElementById('group-api-url');
	const pUrlInput = document.getElementById('api_url');
	const pModelInput = document.getElementById('model');

	function updatePrimaryUi() {
		const meta = providerMeta[pSelect.value];
		if (!meta) return;
		pUrlGroup.style.display = meta.requiresUrl ? '' : 'none';
		if (meta.requiresUrl) pUrlInput.placeholder = meta.placeholderUrl;
		pModelInput.placeholder = meta.placeholderModel;
	}
	pSelect.addEventListener('change', updatePrimaryUi);

	// Sélecteur de secours (Fallback)
	const chkFallback = document.getElementById('enable_fallback');
	const panelFallback = document.getElementById('fallback-settings-panel');
	const fbSelect = document.getElementById('fallback_provider');
	const fbUrlGroup = document.getElementById('group-fallback-api-url');
	const fbUrlInput = document.getElementById('fallback_api_url');
	const fbModelInput = document.getElementById('fallback_model');

	chkFallback.addEventListener('change', () => {
		panelFallback.style.display = chkFallback.checked ? '' : 'none';
	});

	function updateFallbackUi() {
		const meta = providerMeta[fbSelect.value];
		if (!meta) return;
		fbUrlGroup.style.display = meta.requiresUrl ? '' : 'none';
		if (meta.requiresUrl) fbUrlInput.placeholder = meta.placeholderUrl;
		fbModelInput.placeholder = meta.placeholderModel;
	}
	fbSelect.addEventListener('change', updateFallbackUi);

	// Fonction de test réseau
	const form = document.getElementById('llm-config-form');
	const csrf = document.getElementById('_csrf').value;

	function runTest(btn, spinner, feedback, getParams) {
		btn.disabled = true;
		spinner.style.display = 'inline';
		feedback.style.display = 'none';

		const ctrl = new AbortController();
		const tid = setTimeout(() => ctrl.abort(), 12000);

		const fd = new FormData();
		fd.append('action', 'test_connection');
		fd.append('_csrf', csrf);
		const params = getParams();
		for (const [k, v] of Object.entries(params)) {
			fd.append(k, v);
		}

		fetch(form.action, {
			method: 'POST',
			body: fd,
			headers: { 'X-Requested-With': 'XMLHttpRequest' },
			signal: ctrl.signal
		})
		.then(res => {
			clearTimeout(tid);
			if (!res.ok) throw new Error('Erreur HTTP serveur : ' + res.status);
			return res.json();
		})
		.then(data => {
			feedback.style.display = 'block';
			if (data.success) {
				feedback.style.background = '#d4edda';
				feedback.style.color = '#155724';
				feedback.style.border = '1px solid #c3e6cb';
				feedback.innerHTML = '<strong>✔ ' + data.message + '</strong><br>' + data.detail;
			} else {
				feedback.style.background = '#f8d7da';
				feedback.style.color = '#721c24';
				feedback.style.border = '1px solid #f5c6cb';
				feedback.innerHTML = '<strong>❌ ' + data.message + ' (HTTP ' + data.code + ')</strong><br>' + data.detail;
			}
		})
		.catch(err => {
			clearTimeout(tid);
			feedback.style.display = 'block';
			feedback.style.background = '#f8d7da';
			feedback.style.color = '#721c24';
			feedback.style.border = '1px solid #f5c6cb';
			feedback.innerHTML = '<strong>❌ Erreur</strong><br>' + (err.name === 'AbortError' ? 'Délai d’attente dépassé (12s).' : err.message);
		})
		.finally(() => {
			btn.disabled = false;
			spinner.style.display = 'none';
		});
	}

	// Test Moteur Principal
	document.getElementById('btn-test-connection').addEventListener('click', function() {
		runTest(
			this,
			document.getElementById('test-spinner'),
			document.getElementById('test-feedback-box'),
			() => ({
				provider: pSelect.value,
				api_url: pUrlInput.value,
				api_key: document.getElementById('api_key').value,
				model: pModelInput.value,
				timeout: '8'
			})
		);
	});

	// Test Moteur Secours
	document.getElementById('btn-test-fallback').addEventListener('click', function() {
		runTest(
			this,
			document.getElementById('test-fallback-spinner'),
			document.getElementById('test-fallback-feedback'),
			() => ({
				provider: fbSelect.value,
				api_url: fbUrlInput.value,
				api_key: document.getElementById('fallback_api_key').value,
				model: fbModelInput.value,
				timeout: '8'
			})
		);
	});
});
</script>
