<script>
document.addEventListener('DOMContentLoaded', function() {
	const providerMeta = {
		<?php foreach ($allProviders as $p): ?>
		'<?= $p->getId() ?>': {
			requiresUrl: <?= $p->requiresCustomUrl() ? 'true' : 'false' ?>,
			placeholderUrl: '<?= addslashes($p->getPlaceholderUrl()) ?>',
			defaultModel: '<?= addslashes($p->getDefaultModel()) ?>',
			placeholderModel: '<?= addslashes($p->getPlaceholderModel()) ?>'
		},
		<?php endforeach; ?>
	};

	const providerSelect = document.getElementById('provider');
	const urlGroup = document.getElementById('group-api-url');
	const urlInput = document.getElementById('api_url');
	const modelInput = document.getElementById('model');

	function updateUiForProvider() {
		const meta = providerMeta[providerSelect.value];
		if (!meta) return;

		if (meta.requiresUrl) {
			urlGroup.style.display = '';
			urlInput.placeholder = meta.placeholderUrl;
		} else {
			urlGroup.style.display = 'none';
		}
		modelInput.placeholder = meta.placeholderModel;
	}

	providerSelect.addEventListener('change', updateUiForProvider);

	const btnTest = document.getElementById('btn-test-connection');
	const spinner = document.getElementById('test-spinner');
	const feedback = document.getElementById('test-feedback-box');
	const form = document.getElementById('llm-config-form');

	btnTest.addEventListener('click', function() {
		btnTest.disabled = true;
		spinner.style.display = 'inline';
		feedback.style.display = 'none';

		const controller = new AbortController();
		const timeoutId = setTimeout(() => controller.abort(), 12000);

		const formData = new FormData();
		formData.append('action', 'test_connection');
		formData.append('_csrf', document.getElementById('_csrf').value);
		formData.append('provider', providerSelect.value);
		formData.append('api_url', urlInput.value);
		formData.append('api_key', document.getElementById('api_key').value);
		formData.append('model', modelInput.value);
		formData.append('timeout', '8');

		fetch(form.action, {
			method: 'POST',
			body: formData,
			headers: { 'X-Requested-With': 'XMLHttpRequest' },
			signal: controller.signal
		})
		.then(res => {
			clearTimeout(timeoutId);
			if (!res.ok) {
				throw new Error('Erreur HTTP serveur : ' + res.status);
			}
			return res.json();
		})
		.then(data => {
			feedback.style.display = 'block';
			if (data.success) {
				feedback.style.background = '#d4edda';
				feedback.style.color = '#155724';
				feedback.style.border = '1px solid #c3e6cb';
				feedback.innerHTML = '<strong>✔ ' + data.message + '</strong><br>' + data.detail;
			} else {
				feedback.style.background = '#f8d7da';
				feedback.style.color = '#721c24';
				feedback.style.border = '1px solid #f5c6cb';
				feedback.innerHTML = '<strong>❌ ' + data.message + ' (HTTP ' + data.code + ')</strong><br>' + data.detail;
			}
		})
		.catch(err => {
			clearTimeout(timeoutId);
			feedback.style.display = 'block';
			feedback.style.background = '#f8d7da';
			feedback.style.color = '#721c24';
			feedback.style.border = '1px solid #f5c6cb';
			if (err.name === 'AbortError') {
				feedback.innerHTML = '<strong>❌ Délai d’attente dépassé</strong><br>Le serveur n’a pas répondu en 12 secondes. Vérifiez l’URL de l’API et vos connexions sortantes.';
			} else {
				feedback.innerHTML = '<strong>❌ Erreur</strong><br>' + err.message;
			}
		})
		.finally(() => {
			btnTest.disabled = false;
			spinner.style.display = 'none';
		});
	});
});
</script>
